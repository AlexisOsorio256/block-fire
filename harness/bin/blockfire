#!/bin/bash
# BLOCKFIRE Harness — the launcher.
#
# One command to start the product. It does three things the bare `dsh web` does
# not, and nothing else:
#
#   1. Applies the BLOCKFIRE host patch layer (guard + Update Center + the two
#      spaces), without editing the user's own profile patch file.
#   2. Sets the permission policy BLOCKFIRE needs: no approval prompts, because
#      Godot, Blender, Gradle and adb legitimately write outside the workspace
#      and a confined sandbox would break the product's own toolchain. The
#      destructive boundary is the guard plugin, not a question.
#   3. Boots the DSH runtime the shared resolver picks — the Update Center's
#      ACTIVE pin when it has one, otherwise any DSH this machine already has
#      (PATH, local/global node_modules, or the npx cache that `npx
#      @deepseek-ai/dsh` unpacks into). Looking for `dsh` on PATH alone is not
#      enough: under npx, dsh exists only inside that npx process.
#
#   harness/bin/blockfire                    launch the Web surface
#   harness/bin/blockfire --help             this help; other flags reach dsh web
#   DSH_PERMISSION_MODE=workspace-write harness/bin/blockfire    confine this run
#   BLOCKFIRE_DSH_BIN=/path/lib/bin.js harness/bin/blockfire     force a runtime
#
# Runtime resolution rules live in harness/lib/runtime.mjs — read it, do not
# duplicate them here. Anything after the launcher's own flags reaches
# `dsh web` verbatim.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
HARNESS="$(cd "$HERE/.." && pwd)"
DSH_HOME_DIR="${DSH_HOME:-$HOME/.dsh}"
# The installed copy is the one the profile resolves relative row names against;
# install.sh keeps it byte-identical to the repo's file.
PATCH="$DSH_HOME_DIR/profiles/web/blockfire.patch.yml"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
fi

[ -f "$PATCH" ] || { echo "blockfire: missing $PATCH — run harness/install.sh" >&2; exit 1; }

# The toolchain writes ~/.config/godot, ~/.config/blender, ~/.gradle and the adb
# socket. An operator may still confine a run explicitly.
export DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}"

# shellcheck source=lib/runtime.sh
. "$HARNESS/lib/runtime.sh"

if ! blockfire_runtime_resolve; then
	echo "blockfire: no DSH runtime found." >&2
	if command -v node >/dev/null 2>&1; then
		node "$HARNESS/lib/runtime.mjs" >&2 || true
	fi
	echo "fix: start once with npx (npx @deepseek-ai/dsh web), or stage and activate" >&2
	echo "a managed runtime: node harness/bin/update.mjs stage <version>" >&2
	exit 1
fi

echo "BLOCKFIRE Harness — DSH $BLOCKFIRE_RUNTIME_VERSION ($BLOCKFIRE_RUNTIME_SOURCE_LABEL) policy $DSH_PERMISSION_MODE"
exec node "$BLOCKFIRE_DSH_BIN" --profile web --patch "$PATCH" "$@"
