#!/bin/bash
# BLOCKFIRE Harness launcher: purge deferred deletes, resolve DSH, apply Web patch.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
HARNESS="$(cd "$HERE/.." && pwd)"
DSH_HOME_DIR="${DSH_HOME:-$HOME/.dsh}"
PATCH="$DSH_HOME_DIR/profiles/web/blockfire.patch.yml"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	cat <<'EOF'
BLOCKFIRE Harness
  harness/bin/blockfire [dsh-web flags]
  DSH_PERMISSION_MODE=workspace-write harness/bin/blockfire
  BLOCKFIRE_DSH_BIN=/path/lib/bin.js harness/bin/blockfire
EOF
	exit 0
fi

[ -f "$PATCH" ] || { echo "blockfire: missing $PATCH — run harness/install.sh" >&2; exit 1; }
export DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}"

# Session persistence is append-only. Web Delete hides/detaches immediately and
# queues disk artifacts; remove them only at this clean pre-boot boundary.
if [ -f "$HERE/purge-sessions.mjs" ]; then
	node "$HERE/purge-sessions.mjs" || echo "blockfire: warning: some deleted-session artifacts will retry next launch" >&2
fi

# shellcheck source=lib/runtime.sh
. "$HARNESS/lib/runtime.sh"
if ! blockfire_runtime_resolve; then
	echo "blockfire: no DSH runtime found." >&2
	node "$HARNESS/lib/runtime.mjs" >&2 || true
	echo "fix: npx @deepseek-ai/dsh web once, or stage+activate a managed runtime" >&2
	exit 1
fi

# update.mjs runs as a child of this process from the Web plugin. These values
# describe what THIS host actually booted, instead of re-resolving and guessing.
export BLOCKFIRE_RUNNING_DSH_VERSION="$BLOCKFIRE_RUNTIME_VERSION"
export BLOCKFIRE_RUNNING_DSH_SOURCE_LABEL="$BLOCKFIRE_RUNTIME_SOURCE_LABEL"
export BLOCKFIRE_RUNNING_DSH_BIN="$BLOCKFIRE_DSH_BIN"

echo "BLOCKFIRE Harness — DSH $BLOCKFIRE_RUNTIME_VERSION ($BLOCKFIRE_RUNTIME_SOURCE_LABEL) policy $DSH_PERMISSION_MODE"
exec node "$BLOCKFIRE_DSH_BIN" --profile web --patch "$PATCH" "$@"
